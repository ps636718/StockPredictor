# ==============================================================================
# AlphaTrade AI — Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to .env: cp .env.example .env
# 2. Fill in your actual API keys and URLs.
# 3. NEVER commit your actual .env file to version control.
# ==============================================================================

# LLM API Key for Financial Research & AI Report Explainer
# Obtain free key from https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Optional Fallback: OpenAI API Key (used if Groq is unset or unreachable)
OPENAI_API_KEY=sk-your_openai_api_key_here

# Allowed Production Frontend Origin for CORS
# In production on Render, set this to your deployed Vercel domain (e.g. https://your-project.vercel.app)
# For local testing, leave as * or http://localhost:3000
FRONTEND_URL=https://stockai-frontend.vercel.app

# Server Port (Render and cloud hosts bind this dynamically via $PORT)
PORT=8000

# Force Demo Mode (0 = live yfinance data, 1 = static demo fixtures for offline demonstrations)
ALPHATRADE_DEMO_MODE=0

# Python Version specification
PYTHON_VERSION=3.11.8
